          <property name="styleSheet">
           <string notr="true">QTableWidget {
    background-color: #1f1f1f;               /* Background color */
    border: 2px solid #E45638;               /* Border color */
    border-radius: 10px;                     /* Rounded corners */
    color: #ffffff;                          /* Text color */
    font-size: 14px;                         /* Font size */
    padding: 10px;                           /* Padding inside the table */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3); /* Shadow effect */
    transition: all 0.5s ease-in-out;        /* Smooth transition for all properties */
}

QTableWidget::item {
    padding: 5px;
    background-color: #333333;               /* Item background color */
    border: 1px solid #444444;               /* Border color for items */
    color: #ffffff;                          /* Text color for items */
}

QTableWidget::item:hover {
    background-color: #D14829;               /* Background color on hover */
    border: 1px solid #D14829;                /* Border color on hover */
    transform: scale(1.05);                   /* Slightly scale on hover */
    cursor: pointer;                         /* Change cursor to pointer */
}

QTableWidget::item:pressed {
    background-color: #B23A24;               /* Background color when pressed */
    border: 1px solid #B23A24;               /* Border color when pressed */
    transform: scale(0.95);                   /* Slight shrinking effect */
}

QTableWidget::horizontalHeader {
    background-color: #1f1f1f;               /* Header background */
    border: 1px solid #E45638;               /* Header border color */
    color: #E45638;                          /* Header text color */
    font-weight: bold;                       /* Header font weight */
    font-size: 16px;                         /* Header font size */
    padding: 10px;
}

QTableWidget::horizontalHeader::section {
    padding-left: 15px;
    padding-right: 15px;
    background: #1f1f1f;                     /* Background color for header sections */
    border: none;                            /* No border for sections */
    color: #E45638;                          /* Header section text color */
}

QTableWidget::verticalHeader {
    background-color: #1f1f1f;               /* Vertical header background */
    border: 1px solid #E45638;               /* Border for vertical header */
    color: #E45638;                          /* Vertical header text color */
    font-weight: bold;                       /* Vertical header font weight */
}

QTableWidget::verticalHeader::section {
    background: #333333;                     /* Background color for sections */
    border: none;                            /* No border for sections */
    color: #E45638;                          /* Text color */
}

QTableWidget::scrollIndicator {
    background-color: #1f1f1f;               /* Background color of scrollbars */
    border: none;                            /* No borders */
}

QTableWidget::scrollArea {
    border: none;                            /* No border for the scroll area */
}

QTableWidget::item:selected {
    background-color: #D14829;               /* Background color when selected */
    color: #ffffff;                          /* Text color when selected */
}
