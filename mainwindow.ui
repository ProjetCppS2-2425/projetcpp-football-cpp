         <property name="styleSheet">
          <string notr="true">QComboBox {
    color: rgb(255, 255, 255);
    background-color: transparent;
    border: 2px solid #E45638;
    border-radius: 5px;
    padding: 5px;
    selection-background-color: #E45638;
}

/* Dropdown button */
QComboBox::drop-down {
    border: none;
    width: 20px;
    background: transparent;
}

/* Arrow inside the dropdown button (uses default Qt arrow) */
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* Hover effect */
QComboBox:hover {
    border-color: #FF6A4D; /* Lighter shade on hover */
}

/* When focused (clicked) */
QComboBox:focus {
    border-color: #FF3C1F;
}

/* The dropdown menu */
QComboBox QAbstractItemView {
    background-color: #1E1E1E; /* Dark background */
    border: 1px solid #E45638;
    selection-background-color: #E45638;
    color: rgb(255, 255, 255);
    outline: none;
}
</string>
