       <string notr="true">QTabWidget {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #000000, stop: 1 #808080); /* Gradient from black to grey */
    border: none;
}

QTabWidget::pane {
    border: none;  /* Ensures there's no border around the content area */
}

QTabBar {
    background: transparent;  /* Set tab bar background to transparent so the gradient is visible */
}

QTabBar::tab {
    background-color: #4A4A4A; /* Default tab background color */
    color: white;               /* Text color of the tab */
    padding: 10px 20px;         /* Padding inside each tab */
    border: 1px solid #333;     /* Border around the tabs */
    border-radius: 5px;         /* Rounded corners for tabs */
    margin: 0 5px;              /* Space between tabs */
}

QTabBar::tab:selected {
    background-color: #E45638; /* Background color for the selected tab */
    color: white;               /* Text color for the selected tab */
    font-weight: bold;          /* Bold text for selected tab */
}

QTabBar::tab:hover {
    background-color: #555;     /* Background color when hovering over a tab */
    color: white;               /* Text color when hovering */
}
