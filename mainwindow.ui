        <property name="styleSheet">
         <string notr="true">QGroupBox {
    border: 2px solid #E45638;  /* Border color */
    border-radius: 12px;         /* Rounded corners */
    padding: 20px;               /* Padding inside the box */
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #1f1f1f, stop: 1 #808080);  /* Gradient background */
    font-size: 16px;             /* Font size for the text */
    font-weight: bold;           /* Font weight */
    color: #ffffff;              /* Text color */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);  /* Shadow effect */
    transition: all 0.5s ease-in-out;   /* Smooth transition for all properties */
    transform-origin: center;   /* Set the origin for transformation */
}

QGroupBox:hover {
    border: 2px solid #D14829;   /* Change border color on hover */
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #D14829, stop: 1 #808080);  /* Change gradient on hover */
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);  /* Increase shadow on hover */
    transform: scale(1.05) rotate(5deg);  /* Slight scale and rotation animation */
    filter: brightness(1.1); /* Slightly brighten the background */
}

QGroupBox:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #B23A24, stop: 1 #808080);  /* Change background when pressed */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);  /* Return to normal shadow */
    transform: scale(0.95);  /* Slight shrinking effect on press */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    font-size: 18px;             /* Title font size */
    color: #E45638;              /* Title text color */
    margin-left: 10px;           /* Slight margin to the left */
    padding: 0 10px;             /* Padding around the title */
    background: #1f1f1f;         /* Background for the title */
    border-radius: 6px;          /* Rounded title background */
    border: 1px solid #E45638;   /* Border color for the title */
    padding-left: 15px;          /* Padding for title text */
    transition: background-color 0.3s ease, border 0.3s ease, color 0.3s ease; /* Smooth transition for title */
}

QGroupBox::title:hover {
    background: #D14829;         /* Title background change on hover */
    border: 1px solid #D14829;    /* Title border color on hover */
    color: white;                /* Title text color on hover */
    transform: translateY(-5px); /* Title moves up a bit on hover */
}

QGroupBox::title:pressed {
    background: #B23A24;         /* Title background change on press */
    border: 1px solid #B23A24;    /* Title border color on press */
    color: white;                /* Title text color on press */
    transform: translateY(5px);  /* Title moves down a bit on press */
}

QGroupBox:hover {
    border: 2px solid #D14829;   /* Hover border color */
    box-shadow: 0 0 15px #D14829; /* Glowing shadow effect */
    transform: scale(1.05) rotate(5deg);  /* Scaling and rotating on hover */
    filter: brightness(1.1); /* Slightly brighten */
}</string>
