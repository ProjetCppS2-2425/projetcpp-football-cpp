      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: #E45638;
    color: black;
    border: 2px solid #E45638;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.3s, transform 0.2s, box-shadow 0.3s, color 0.3s; /* Include color transition */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}
QMainWindow, QWidget {
    background-color: #1E1E1E;
    color: white;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #D14829;
    border: 2px solid #D14829;
    cursor: crosshair; /* Change cursor to crosshair on hover */
    transform: scale(1.1);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    filter: brightness(1.1);
    color: white; /* Change text color on hover */
}

QPushButton:pressed {
    background-color: #B23A24;
    border: 2px solid #B23A24;
    transform: scale(0.95);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #b0b0b0;
    border: 2px solid #e0e0e0;
    cursor: not-allowed;
    box-shadow: none;
}
</string>
